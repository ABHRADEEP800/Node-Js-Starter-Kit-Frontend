# ===========================================================
# Starter Kit — Frontend (Vite) environment
# Copy this file to `.env` and fill in the values.
# ===========================================================

# Express backend origin (backend/ or backnd-ts/).
VITE_API_HOST_URL=http://localhost:5000
# API prefix.
VITE_API_DEFAULT_PATH=/api/v1

# Google reCAPTCHA v3 SITE key (public; pair with RECAPTCHA_SECRET_KEY on the
# backend). Create at https://www.google.com/recaptcha/admin/create and add
# every hostname you serve from (incl. localhost).
VITE_RECAPTCHA_SITE_KEY=

# Brand name shown in the UI.
VITE_PROJECT_NAME=Starter Kit
